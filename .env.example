# ============================================================
#  BLS Vanguard — production environment template
#  Copy to .env and fill every value marked REQUIRED.
#  cp .env.example .env
# ============================================================

# ---------- Database (REQUIRED) ----------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ---------- First boot ----------
# Password for the owner account (username: blsvisa).
# Minimum 12 characters. If omitted, a random one is printed
# to the server console exactly once on first boot.
SEED_OWNER_PASSWORD=

# ---------- Transport security (REQUIRED in production) ----------
# Set to true once TLS terminates in front of the app.
FORCE_HTTPS=false

# ---------- Booking engine heartbeat ----------
# Shared secret allowing cron / the desktop shell to tick the
# engine without a browser session.   openssl rand -hex 24
ENGINE_SECRET=
# Owner id. Query: select id from operators where username='blsvisa';
ENGINE_OPERATOR_ID=1

# ---------- BLS connector ----------
# simulation = local drill, no network calls (default)
# live       = real gateway calls using YOUR OWN BLS account
BLS_MODE=simulation
BLS_API_BASE_URL=https://bls.dz
BLS_LOGIN_PATH=/api/auth/login
BLS_SLOTS_PATH=/api/appointment/slots
BLS_BOOK_PATH=/api/appointment/book
BLS_TIMEOUT_MS=12000
BLS_USER_AGENT=

# Auth: EITHER a session cookie OR email + password.
# Values can also be saved from the Integration form at runtime.
BLS_SESSION_COOKIE=
BLS_ACCOUNT_EMAIL=
BLS_ACCOUNT_PASSWORD=
BLS_API_KEY=
BLS_CENTER_ID=

# Optional. Only relevant if the gateway demands a machine token.
BLS_CAPTCHA_API_KEY=

# ---------- Human CAPTCHA gate ----------
# The engine never solves CAPTCHAs. It raises a challenge and waits
# for a person. This is the window they have to answer.
BLS_CAPTCHA_TIMEOUT_MS=120000

# ---------- Sign-in protection ----------
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
LOGIN_LOCK_MS=900000

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Desktop shell (optional) ----------
VANGUARD_URL=http://localhost:3000
VANGUARD_TICK_MS=20000
